{
  "name": "visual-database-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Visual Database Studio — Commercial SQL Server Command Center (Web & Windows Desktop)",
  "author": "Visual Database Studio",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "db:migrate": "tsx src/server/runMigrations.ts",
    "test": "tsx --test src/**/*.test.ts agent/src/discovery.test.ts",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:build": "vite build && node scripts/build-desktop.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win --x64",
    "desktop:test": "tsx --test electron/*.test.ts src/lib/db/sqlserver.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@types/mssql": "^12.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^13.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
