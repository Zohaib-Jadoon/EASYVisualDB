# Visual Database Studio — Environment Configuration Example
# Copy to ".env" for local Windows 11 / Node.js development.
# NEVER commit real API keys, passwords, or ".env" files to Git.

# Server listening port (must match APP_URL when running locally)
PORT=3000
APP_URL="http://localhost:3000"

# Control-plane & sandbox SQLite storage directory (defaults to ./data)
VDS_DATA_DIR="./data"

# 32+ character encryption passphrase used for AES-256-GCM credential vault & HMAC session signing.
# If omitted on localhost, a random key is generated at data/.vds-master.key on first boot.
VDS_MASTER_KEY=""

# Commercial SaaS authentication toggle:
# false (default on localhost): allows workspace actor switching + optional Sign In
# true: enforces authenticated session cookies on all /api/* workspace routes
REQUIRE_LOGIN="false"

# Optional Google Gemini API key for server-side AI Schema Draft / NL-to-SQL / SQL Explain / Docs
GEMINI_API_KEY=""

# Optional Microsoft Entra ID (Azure AD) App Registration for Azure SQL password auth
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""

# Optional Stripe-compatible Billing Integration (omit on localhost for manual_invoice mode)
STRIPE_SECRET_KEY=""
BILLING_WEBHOOK_SECRET=""
BILLING_CHECKOUT_BASE_URL=""
